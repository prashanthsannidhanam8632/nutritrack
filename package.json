{
  "name": "nutritrack",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered nutrition tracker with food scanning, macro tracking and step-by-step recipe guides",
  "keywords": ["nutrition", "fitness", "health", "food-tracker", "macro-tracker", "react", "pwa"],
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev":     "vite",
    "build":   "vite build",
    "preview": "vite preview",
    "lint":    "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "format":  "prettier --write \"src/**/*.{js,jsx,css}\"",
    "test":    "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react":     "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react":                "^18.2.0",
    "@types/react-dom":            "^18.2.0",
    "@vitejs/plugin-react":        "^4.2.0",
    "@vitest/coverage-v8":         "^1.2.0",
    "eslint":                      "^8.57.0",
    "eslint-plugin-react":         "^7.33.0",
    "eslint-plugin-react-hooks":   "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom":                       "^24.0.0",
    "prettier":                    "^3.2.0",
    "vite":                        "^5.1.0",
    "vite-plugin-pwa":             "^0.19.0",
    "vitest":                      "^1.2.0"
  }
}
